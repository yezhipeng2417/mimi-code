{
  "name": "@mimi/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mimi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mimi/core": "workspace:*",
    "@mimi/tools": "workspace:*",
    "@mimi/permissions": "workspace:*",
    "@mimi/mcp": "workspace:*",
    "@mimi/hooks": "workspace:*",
    "@mimi/skills": "workspace:*",
    "@mimi/agents": "workspace:*",
    "@mimi/ui": "workspace:*",
    "@mimi/brand": "workspace:*",
    "@anthropic-ai/sdk": "^0.39.0",
    "commander": "^12.0.0",
    "ink": "^5.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "vitest": "^1.3.1",
    "typescript": "^5.7.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64"
  }
}
