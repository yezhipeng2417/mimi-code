    "yoga-wasm-web": "^0.3.3"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "vitest": "^1.3.1",
    "typescript": "^5.7.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64"
  }
