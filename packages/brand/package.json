{
  "name": "@mimi/brand",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mimi/core": "workspace:*",
    "@mimi/hooks": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "vitest": "^1.3.1",
    "typescript": "^5.7.0",
    "@types/node": "^20.11.24"
  }
}
